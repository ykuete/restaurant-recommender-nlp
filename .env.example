# Copy to .env and fill in real values. Never commit .env.

# --- Paths -----------------------------------------------------------------
# Folder holding the raw Yelp JSON files (yelp_academic_dataset_*.json)
DATA_DIR=data
# Folder for everything the pipeline builds: parquet, profiles, index, model
ARTIFACTS_DIR=artifacts

# --- Hugging Face Hub (private repo holding the model and artifacts) -------
HF_REPO_ID=your-username/tastelens-artifacts
# Read token for the API; write token only on the machine that uploads
HF_TOKEN=

# --- Generative summary -----------------------------------------------------
# anthropic | openai | none (none = template summaries only)
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- API ----------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000
# Feedback storage. SQLite locally; a Postgres URL (e.g. Neon) in production
DATABASE_URL=sqlite:///feedback.db

# --- Frontend (frontend/.env.local) ----------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
