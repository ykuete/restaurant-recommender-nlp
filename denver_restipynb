      "source": [
        "\n",
        "import requests\n",
        "import pandas as pd\n",
        "\n",
        "OVERPASS_URL = \"https://overpass-api.de/api/interpreter\"\n",
        "\n",
        "# Denver metropolitan area bounding box\n",
        "bbox = \"39.55,-105.25,39.95,-104.55\"\n",
        "\n",
        "query = f\"\"\"\n",
        "[out:json][timeout:180];\n",
        "(\n",
        "  nwr[\"amenity\"=\"restaurant\"]({bbox});\n",
        "  nwr[\"amenity\"=\"cafe\"]({bbox});\n",
        "  nwr[\"amenity\"=\"fast_food\"]({bbox});\n",
        ");\n",
        "out center tags;\n",
        "\"\"\"\n",
        "\n",
        "response = requests.get(\n",
        "    OVERPASS_URL,\n",
        "    params={\"data\": query},\n",
        "    timeout=200\n",
        ")\n",
        "\n",
        "response.raise_for_status()\n",
        "elements = response.json()[\"elements\"]\n",
        "\n",
        "rows = []\n",
        "\n",
        "for element in elements:\n",
        "    tags = element.get(\"tags\", {})\n",
        "\n",
        "    if not tags.get(\"name\"):\n",
        "        continue\n",
        "\n",
        "    # Nodes have direct coordinates.\n",
        "    # Ways and relations have center coordinates.\n",
        "    if \"lat\" in element:\n",
        "        lat = element[\"lat\"]\n",
        "        lon = element[\"lon\"]\n",
        "    else:\n",
        "        center = element.get(\"center\", {})\n",
        "        lat = center.get(\"lat\")\n",
        "        lon = center.get(\"lon\")\n",
        "\n",
        "    address = tags.get(\"addr:street\")\n",
        "\n",
        "    rows.append({\n",
        "        \"osm_id\": element[\"id\"],\n",
        "        \"name\": tags.get(\"name\"),\n",
        "        \"type\": tags.get(\"amenity\"),\n",
        "        \"cuisine\": tags.get(\"cuisine\"),\n",
        "        \"latitude\": lat,\n",
        "        \"longitude\": lon,\n",
        "        \"street\": address,\n",
        "        \"house_number\": tags.get(\"addr:housenumber\"),\n",
        "        \"city\": tags.get(\"addr:city\"),\n",
        "        \"postcode\": tags.get(\"addr:postcode\"),\n",
        "        \"website\": tags.get(\"website\")\n",
        "    })\n",
        "\n",
        "df = pd.DataFrame(rows)\n",
        "\n",
        "df = df.drop_duplicates(subset=[\"osm_id\"])\n",
        "\n",
        "df.to_csv(\"denver_restaurants.csv\", index=False)\n",
        "\n",
        "print(\"Restaurants collected:\", len(df))\n",
        "print(df.head())\n"
